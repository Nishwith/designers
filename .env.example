# Supabase Backend Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Razorpay Test / Production Key ID
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# Cloudflare R2 Public CDN / Media Base URL
VITE_MEDIA_BASE_URL=

# Cross-App Links: Main User Portal
# Staging Netlify: https://vishwakarmans.netlify.app
# Local development: http://localhost:5173
# Production custom domain: https://vishwakarmans.com
VITE_MAIN_APP_URL=https://vishwakarmans.netlify.app

# Cross-App Links: Designer Portal
# Staging Netlify: https://designers-v.netlify.app
# Local development: http://localhost:5174
# Production custom domain: https://designers.vishwakarmans.com
VITE_DESIGNER_APP_URL=https://designers-v.netlify.app

# Phase 1A Hardening RPC Feature Flags
# Default: false for staging/fallback mode. Flip to true after rev7 SQL migration runs in production.
VITE_PHASE1A_ADMIN_AUTH_RPC_ENABLED=false
VITE_PHASE1A_DESIGNER_REQUEST_RPC_ENABLED=false
VITE_PHASE1A_INQUIRY_RPC_ENABLED=false
VITE_PHASE1A_SELF_HIDE_RPC_ENABLED=false
